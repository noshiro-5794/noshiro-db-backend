# Copy this file to .env.production and replace every change-this value.
# Never commit .env.production. Boolean values use True or False.

# Application
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=noshiro.moe,www.noshiro.moe,api.noshiro.moe,127.0.0.1,localhost
TZ=Asia/Shanghai
FRONTEND_SITE_URL=https://noshiro.moe

# Browser security
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://noshiro.moe,https://www.noshiro.moe
CSRF_TRUSTED_ORIGINS=https://noshiro.moe,https://www.noshiro.moe,https://api.noshiro.moe

# Database
# Host services are reached from containers through host.docker.internal.
DATABASE_URL=postgresql://noshiro:change-this-password@host.docker.internal:5433/noshiro_db
DATABASE_SSL_REQUIRE=False

# JWT refresh cookie
JWT_REFRESH_COOKIE_NAME=noshiro_refresh
JWT_REFRESH_COOKIE_PATH=/api/users/
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_MAX_AGE=2592000

# Celery and Redis
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
CACHE_URL=redis://host.docker.internal:6379/2

# MinIO object storage
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_USE_HTTPS=False
MINIO_BUCKET=noshiro-avatars
MINIO_PUBLIC_URL=https://avatar.noshiro.moe
AVATAR_MAX_UPLOAD_SIZE=10485760
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Email verification
RESEND_API_KEY=change-this-resend-api-key
EMAIL_FROM=noreply@mail.noshiro.moe

# hCaptcha
HCAPTCHA_ENABLED=True
HCAPTCHA_SECRET_KEY=change-this-hcaptcha-secret-key
HCAPTCHA_SITEVERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_TIMEOUT=5

# Bangumi provider
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_API_KEY=
BANGUMI_USER_AGENT="Noshiro_5794/noshiro_db (https://github.com/noshiro-5794)"
BANGUMI_TIMEOUT=30
BANGUMI_RATE_LIMIT_INTERVAL=0.3
BANGUMI_IMAGE_ALLOWED_HOSTS=lain.bgm.tv
BANGUMI_IMAGE_MAX_BYTES=10485760

# AI name normalization (optional; falls back to the original name when unset)
AI_AGENT_API_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_AGENT_API_KEY=
AI_AGENT_MODEL=Pro/zai-org/GLM-4.7
AI_AGENT_TIMEOUT=30

# Synchronization schedule and limits
SYNC_CALENDAR_CRON_HOUR=3
SYNC_CALENDAR_CRON_MINUTE=30
SYNC_INCREMENTAL_CRON_HOUR=4
SYNC_INCREMENTAL_CRON_MINUTE=0
SYNC_INCREMENTAL_SUBJECT_BATCH_SIZE=1000
SYNC_INCREMENTAL_MAX_CONSECUTIVE_ERRORS=20
SYNC_INCREMENTAL_MAX_CONSECUTIVE_SKIPS=50

# Container process tuning
WEB_PORT=8008
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_WORKER_CONCURRENCY=2
