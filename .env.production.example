# Copy this file to .env.production and replace every change-this value.
# Never commit .env.production. Boolean values use True or False.

# Application
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.noshiro.moe,127.0.0.1,localhost
TZ=Asia/Shanghai
FRONTEND_SITE_URL=https://app.noshiro.moe
# Optional. Defaults to FRONTEND_SITE_URL + /problems/
# PROBLEM_BASE_URI=https://app.noshiro.moe/problems/

# Browser security
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://app.noshiro.moe
CSRF_TRUSTED_ORIGINS=https://app.noshiro.moe,https://api.noshiro.moe
# Replace this example with the exact Docker gateway or reverse proxy CIDR.
TRUSTED_PROXY_CIDRS=172.17.0.1/32
ENABLE_ADMIN=False
ENABLE_API_DOCS=False
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Database
# Host services are reached from containers through host.docker.internal.
DATABASE_URL=postgresql://noshiro:change-this-password@postgres:5432/noshiro_db
DATABASE_SSL_REQUIRE=False

# JWT refresh cookie
JWT_REFRESH_COOKIE_NAME=noshiro_refresh
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_MAX_AGE=2592000

# Celery and Redis
CELERY_BROKER_URL=redis://redis-broker:6379/0
CACHE_URL=redis://redis-cache:6379/1
CELERY_VISIBILITY_TIMEOUT=7200
CELERY_REALTIME_CONCURRENCY=2
CELERY_AI_CONCURRENCY=1
CELERY_SYNC_CONCURRENCY=1

# MinIO object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_USE_HTTPS=False
MINIO_BUCKET=noshiro-avatars
MINIO_PUBLIC_URL=https://avatar.noshiro.moe
AVATAR_MAX_UPLOAD_SIZE=10485760
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Email verification
RESEND_API_KEY=change-this-resend-api-key
EMAIL_FROM=noreply@mail.noshiro.moe

# hCaptcha
HCAPTCHA_ENABLED=True
HCAPTCHA_SECRET_KEY=change-this-hcaptcha-secret-key
HCAPTCHA_SITEVERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_TIMEOUT=5

# Bangumi provider
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_API_KEY=
BANGUMI_USER_AGENT="Noshiro_5794/noshiro-db (https://github.com/noshiro-5794)"
BANGUMI_TIMEOUT=30
BANGUMI_RATE_LIMIT_INTERVAL=0.3
BANGUMI_IMAGE_ALLOWED_HOSTS=lain.bgm.tv
BANGUMI_IMAGE_MAX_BYTES=10485760

# VNDB Kana
VNDB_API_BASE_URL=https://api.vndb.org/kana
VNDB_USER_AGENT="Noshiro_5794/noshiro-db (https://github.com/noshiro-5794)"
VNDB_TIMEOUT=30
VNDB_RATE_LIMIT_INTERVAL=1.0

# AI proposal and matching provider (optional)
AI_AGENT_API_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_AGENT_API_KEY=
AI_PRIMARY_MODEL=zai-org/GLM-5.2
AI_FAST_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
AI_REASONING_MODEL=deepseek-ai/DeepSeek-V4-Pro
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
AI_AGENT_TIMEOUT=30
ANILIST_RATE_LIMIT_INTERVAL=0.75
# v2raya plain HTTP inbound; routes all outbound HTTP(S) through the proxy.
OUTBOUND_PROXY_URL=http://192.168.3.222:7890
OUTBOUND_NO_PROXY_HOSTS=localhost,127.0.0.1,postgres,redis-broker,redis-cache,minio

# MCP (enable the optional Compose profile only after reverse proxy setup)
MCP_HOST=0.0.0.0
MCP_PORT=8010
MCP_RATE_LIMIT=60
MCP_RATE_WINDOW_SECONDS=60

# Synchronization schedule and limits
SYNC_CALENDAR_CRON_HOUR=3
SYNC_CALENDAR_CRON_MINUTE=30
SYNC_INCREMENTAL_CRON_HOUR=4
SYNC_INCREMENTAL_CRON_MINUTE=0
SYNC_INCREMENTAL_SUBJECT_BATCH_SIZE=1000
SYNC_INCREMENTAL_MAX_CONSECUTIVE_ERRORS=20
SYNC_INCREMENTAL_MAX_CONSECUTIVE_SKIPS=50

# Container process tuning
APP_IMAGE=noshiro-db-backend
APP_IMAGE_TAG=change-this-to-git-sha
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8008
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_REALTIME_CONCURRENCY=2
CELERY_AI_CONCURRENCY=1
CELERY_SYNC_CONCURRENCY=1

# Infrastructure Compose
NOSHIRO_DATA_ROOT=/vol1/1000/noshiro-data
NOSHIRO_BACKUP_ROOT=/vol1/1000/noshiro-backup
POSTGRES_DB=noshiro_db
POSTGRES_USER=noshiro
POSTGRES_PASSWORD=change-this-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
REDIS_BROKER_BIND_ADDRESS=127.0.0.1
REDIS_BROKER_PORT=6380
REDIS_CACHE_BIND_ADDRESS=127.0.0.1
REDIS_CACHE_PORT=6381
