# Copy this file to .env for local development.
# Use True or False for boolean values.

# Application
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TZ=Asia/Shanghai
FRONTEND_SITE_URL=http://localhost:5173

# Browser security
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/noshiro_db
# Must use a dedicated database whose name ends with _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/noshiro_test
DATABASE_SSL_REQUIRE=False

# JWT refresh cookie
JWT_REFRESH_COOKIE_NAME=noshiro_refresh
JWT_REFRESH_COOKIE_PATH=/api/users/
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_MAX_AGE=2592000

# Celery and Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CACHE_URL=redis://127.0.0.1:6379/2

# MinIO object storage
# MINIO_ENDPOINT accepts host:port or a URL; an https:// URL enables TLS.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_HTTPS=False
MINIO_BUCKET=noshiro-avatars
MINIO_PUBLIC_URL=http://127.0.0.1:9000
AVATAR_MAX_UPLOAD_SIZE=10485760
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Email verification
RESEND_API_KEY=
EMAIL_FROM=noreply@noshiro.moe

# hCaptcha
HCAPTCHA_ENABLED=False
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITEVERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_TIMEOUT=5

# Bangumi provider
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_API_KEY=
BANGUMI_USER_AGENT="Noshiro_5794/noshiro_db (https://github.com/noshiro-5794)"
BANGUMI_TIMEOUT=30
BANGUMI_RATE_LIMIT_INTERVAL=0.3
BANGUMI_IMAGE_ALLOWED_HOSTS=lain.bgm.tv
BANGUMI_IMAGE_MAX_BYTES=10485760

# AI name normalization (optional; falls back to the original name when unset)
AI_AGENT_API_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_AGENT_API_KEY=
AI_AGENT_MODEL=Pro/zai-org/GLM-4.7
AI_AGENT_TIMEOUT=30

# Synchronization schedule and limits
SYNC_CALENDAR_CRON_HOUR=3
SYNC_CALENDAR_CRON_MINUTE=30
SYNC_INCREMENTAL_CRON_HOUR=4
SYNC_INCREMENTAL_CRON_MINUTE=0
SYNC_INCREMENTAL_SUBJECT_BATCH_SIZE=1000
SYNC_INCREMENTAL_MAX_CONSECUTIVE_ERRORS=20
SYNC_INCREMENTAL_MAX_CONSECUTIVE_SKIPS=50

# Container process tuning
WEB_PORT=8008
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_WORKER_CONCURRENCY=2
